{
  // ГОТОВЫЙ ФАЙЛ ЦЕЛИКОМ — замена ~/.config/opencode/opencode.jsonc.
  // Твои провайдеры и модель перенесены дословно.
  // Если не хочешь заменять файл целиком — влей вручную 3 ключа из
  // opencode.agents.fragment.jsonc: default_agent, permissions, agents.
  // Перед заменой: cp ~/.config/opencode/opencode.jsonc ~/.config/opencode/opencode.jsonc.bak
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "GPU_0123": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "Local vLLM GPU_0123",
      "settings": {
        "baseURL": "http://10.55.228.60:8003/v1",
        "apiKey": "EMPTY",
        "max_tokens": 131072,
        "reasoningEffort": "high"
      },
      "models": {
        "main": {
          "modelID": "deepseek-v41-flash-1017",
          "name": "DeepSeek-V4.1-Flash-1017",
          "limit": { "context": 1048576, "output": 131072 },
          "variants": [
            { "id": "low",  "settings": { "reasoningEffort": "low" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh","settings": { "reasoningEffort": "xhigh" } },
            { "id": "max",  "settings": { "reasoningEffort": "max" } }
          ],
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] }
        }
      }
    },
    "GPU_4": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "Local vLLM GPU_4",
      "settings": {
        "baseURL": "http://10.55.228.60:8002/v1",
        "apiKey": "EMPTY",
        "max_tokens": 131072,
        "reasoningEffort": "medium"
      },
      "models": {
        "fast": {
          "modelID": "Qwen3.8-Flash-Next_GPU4",
          "name": "Qwen3.8-Flash-Next",
          "limit": { "context": 262144, "output": 131072 },
          "variants": [
            { "id": "low",    "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "xhigh",  "settings": { "reasoningEffort": "xhigh" } }
          ],
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] }
        }
      }
    },
    "GPU_5": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "Local vLLM GPU_5",
      "settings": {
        "baseURL": "http://10.55.228.60:8001/v1",
        "apiKey": "EMPTY",
        "max_tokens": 131072,
        "reasoningEffort": "medium"
      },
      "models": {
        "fast": {
          "modelID": "Qwen3.8-Flash-Next_GPU5",
          "name": "Qwen3.8-Flash-Next",
          "limit": { "context": 262144, "output": 131072 },
          "variants": [
            { "id": "low",    "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "xhigh",  "settings": { "reasoningEffort": "xhigh" } }
          ],
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] }
        }
      }
    }
  },
  "model": "GPU_0123/main",

  // ════════════════════════════════════════════════════════════════════════
  // КАРКАС АГЕНТНОЙ СХЕМЫ
  // Порядок совпадений: база OpenCode ("разрешено всё", external_directory→ask,
  // *.env→ask) → глобальные permissions → правила агента. Выигрывает ПОСЛЕДНЕЕ
  // совпадение, поэтому широкое правило идёт первым, allow — после, deny — в конце.
  // ════════════════════════════════════════════════════════════════════════
  "default_agent": "plan",

  "permissions": [
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },

    { "action": "shell", "resource": "git push*", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "deny" },
    { "action": "shell", "resource": "git clean -fd*", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf*", "effect": "deny" },
    { "action": "shell", "resource": "sudo*", "effect": "deny" },

    { "action": "edit", "resource": "**/target/**", "effect": "deny" },
    { "action": "edit", "resource": "**/node_modules/**", "effect": "deny" },
    { "action": "edit", "resource": "**/__pycache__/**", "effect": "deny" },
    { "action": "edit", "resource": "**/.venv/**", "effect": "deny" },
    { "action": "edit", "resource": "**/.venv*/**", "effect": "deny" },
    { "action": "edit", "resource": "**/*.egg-info/**", "effect": "deny" },
    { "action": "edit", "resource": "UnrealProject/Binaries/**", "effect": "deny" },
    { "action": "edit", "resource": "UnrealProject/Intermediate/**", "effect": "deny" },
    { "action": "edit", "resource": "UnrealProject/Saved/**", "effect": "deny" },
    { "action": "edit", "resource": "UnrealProject/DerivedDataCache/**", "effect": "deny" },
    { "action": "edit", "resource": "UnrealProject/Build/**", "effect": "deny" }
  ],

  "agents": {
    "build": {
      "model": "GPU_0123/main",
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "cartographer", "effect": "allow" },
        { "action": "subagent", "resource": "scout", "effect": "allow" },
        { "action": "subagent", "resource": "writer", "effect": "allow" },
        { "action": "subagent", "resource": "verifier", "effect": "allow" },
        { "action": "subagent", "resource": "reviewer", "effect": "allow" },
        { "action": "subagent", "resource": "general", "effect": "deny" },
        { "action": "subagent", "resource": "explore", "effect": "deny" },

        { "action": "grep", "resource": "*", "effect": "deny" },
        { "action": "glob", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "*", "effect": "deny" },

        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "git status*", "effect": "allow" },
        { "action": "shell", "resource": "git diff*", "effect": "allow" },

        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": ".agent/**", "effect": "allow" },

        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "execute", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*", "effect": "allow" }
      ]
    },

    "plan": {
      "model": "GPU_0123/main",
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "cartographer", "effect": "allow" },
        { "action": "subagent", "resource": "scout", "effect": "allow" },
        { "action": "subagent", "resource": "verifier", "effect": "allow" },
        { "action": "subagent", "resource": "reviewer", "effect": "allow" },
        { "action": "subagent", "resource": "general", "effect": "deny" },
        { "action": "subagent", "resource": "explore", "effect": "deny" },

        { "action": "grep", "resource": "*", "effect": "deny" },
        { "action": "glob", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "*", "effect": "deny" },

        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "git status*", "effect": "allow" },
